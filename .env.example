# AI Virtual Companion - Environment Variables Template
# Copy this file to .env.local and fill in your values

# ==============================================
# GEMINI API CONFIGURATION
# ==============================================

# Get your API key from: https://makersuite.google.com/app/apikey
# Note: In this application, the API key is configured through the UI
# and stored in browser localStorage for security
# VITE_GEMINI_API_KEY=your_api_key_here

# ==============================================
# AVATAR CONFIGURATION (Optional)
# ==============================================

# Ready Player Me avatar URL
# Get one from: https://readyplayer.me
# Example: https://models.readyplayer.me/64bfa15f0e72c63d7c3934a6.glb
# VITE_DEFAULT_AVATAR_URL=

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Development server port (default: 3000)
# VITE_PORT=3000

# ==============================================
# NOTES
# ==============================================

# - This app uses browser localStorage for API key storage
# - No .env file is required for basic operation
# - Configure API key through the UI on first launch
# - All VITE_ prefixed variables are exposed to client
# - Never commit .env files with actual keys to git
